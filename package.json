{
  "name": "storybook-addon-ai-chatbot",
  "version": "1.0.0",
  "description": "Add the Asyntai AI chat assistant to your Storybook. It answers questions about your components from your own docs, in 80+ languages.",
  "main": "./preset.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./preset.js"
    },
    "./preset": {
      "types": "./index.d.ts",
      "default": "./preset.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "preset.js",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "storybook-addon",
    "organize",
    "storybook",
    "chatbot",
    "ai",
    "chat",
    "documentation",
    "design-system",
    "support",
    "asyntai"
  ],
  "storybook": {
    "displayName": "Asyntai AI Chatbot",
    "icon": "https://asyntai.com/static/images/icon-512.png",
    "supportedFrameworks": [
      "react",
      "vue",
      "angular",
      "web-components",
      "ember",
      "html",
      "svelte",
      "preact",
      "react-native"
    ]
  },
  "homepage": "https://asyntai.com/documentation/integrations/storybook/",
  "bugs": {
    "url": "https://github.com/asyntai/storybook-addon-ai-chatbot/issues",
    "email": "hello@asyntai.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asyntai/storybook-addon-ai-chatbot.git"
  },
  "author": "Asyntai <hello@asyntai.com> (https://asyntai.com)",
  "license": "MIT",
  "engines": {
    "node": ">=18.0"
  },
  "peerDependencies": {
    "storybook": "^8.0.0 || ^9.0.0 || ^10.0.0"
  },
  "peerDependenciesMeta": {
    "storybook": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node tests/test_preset.js"
  }
}
